{
  "descripcion": "El mismo coordinador, pero con el bot Lanzador: crea y destruye droplets desde el movil.",
  "repo": "stalinbeltran/telegram-coordinator",
  "install": "npm ci",
  "start": "npm start",
  "env_prefix": "TGL_",
  "notas": "Los ejecutores viven AQUI y no en el repo del coordinador a proposito: llaman a comandos de este repo, y si viajaran separados una de las dos mitades quedaria desfasada sin avisar. El precio es que un ejecutor nuevo no llega con `git pull`; se aplica con `do_droplet.py install-executors`, que corre dentro de la maquina y no necesita la laptop.",
  "files": {
    "data/executors/lanzar.json": {
      "name": "lanzar",
      "command": "cd \"$HOME/src/digital-ocean-dropplet-auto-launching\" && python3 scripts/do_droplet.py {{input}}",
      "encargados": [
        "echo"
      ],
      "timeoutMs": 0
    },
    "data/executors/actualizar.json": {
      "name": "actualizar",
      "command": "cd \"$HOME/src/digital-ocean-dropplet-auto-launching\" && python3 scripts/do_droplet.py update",
      "encargados": [
        "echo"
      ],
      "timeoutMs": 0
    },
    "data/executors/ejecutores.json": {
      "name": "ejecutores",
      "command": "cd \"$HOME/src/digital-ocean-dropplet-auto-launching\" && python3 scripts/do_droplet.py install-executors --service telegram-launcher",
      "encargados": [
        "echo"
      ],
      "timeoutMs": 0
    },
    "data/executors/vast.json": {
      "name": "vast",
      "command": "cd \"$HOME/src/digital-ocean-dropplet-auto-launching\" && python3 scripts/vast_instance.py {{input}}",
      "encargados": [
        "echo"
      ],
      "timeoutMs": 0
    },
    "data/executors/datos.json": {
      "name": "datos",
      "command": "cd \"$HOME/src/digital-ocean-dropplet-auto-launching\" && python3 scripts/dataset.py {{input}}",
      "encargados": [
        "echo"
      ],
      "timeoutMs": 0
    },
    "data/executors/estado.json": {
      "name": "estado",
      "command": "cd \"$HOME/src/digital-ocean-dropplet-auto-launching\" && python3 scripts/do_droplet.py list; echo; python3 scripts/vast_instance.py list",
      "encargados": [
        "echo"
      ],
      "timeoutMs": 0
    },
    "data/executors/apagar-vast.json": {
      "name": "apagar-vast",
      "command": "cd \"$HOME/src/digital-ocean-dropplet-auto-launching\" && python3 scripts/vast_instance.py destroy --all --yes",
      "encargados": [
        "echo"
      ],
      "timeoutMs": 0
    },
    "data/executors/apagar-do.json": {
      "name": "apagar-do",
      "command": "cd \"$HOME/src/digital-ocean-dropplet-auto-launching\" && python3 scripts/do_droplet.py destroy --tag ephemeral --yes",
      "encargados": [
        "echo"
      ],
      "timeoutMs": 0
    }
  }
}
