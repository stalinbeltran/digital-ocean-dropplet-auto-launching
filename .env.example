# Copia este fichero a .env y rellena DO_TOKEN. .env está en .gitignore.
# Créalo en https://cloud.digitalocean.com/account/api/tokens
# Scopes necesarios: droplet:create, droplet:read, droplet:delete,
#                    actions:read, ssh_key:read, ssh_key:create
DO_TOKEN=dop_v1_pon_aqui_tu_token

# --- Droplet -----------------------------------------------------------------
# Tipo de maquina por defecto: un descriptor de types/ que fija de una vez plan,
# imagen, region y plantilla de arranque. Es lo comodo para las GPU, que ademas
# del plan necesitan su imagen con drivers. Vacio = se usan las variables
# sueltas de aqui abajo, como siempre.
#   python scripts/do_droplet.py types      <- los definidos, con su precio
#   python scripts/do_droplet.py launch p5 --type gpu-rtx4000
DO_TYPE=

# s-2vcpu-4gb = 2 vCPU / 4 GB RAM / 80 GB SSD / $24 al mes.
# El disco no se elige aparte: viene fijo con el plan.
DO_SIZE=s-2vcpu-4gb
DO_IMAGE=ubuntu-24-04-x64
DO_REGION=nyc1
DO_DROPLET_NAME=proyecto-01
DO_TAG=ephemeral

# Freno de mano contra un lanzamiento caro por error, en dolares al mes. Por
# encima de esto `launch` se niega y pide --accept-cost. Existe porque un plan
# con GPU va de 565 a 3.281 al mes (hasta 137 veces el droplet de trabajo) y
# desde el movil un tipo mal escrito se manda igual de rapido que el bueno.
# 0 = sin freno.
DO_MAX_PRICE_MONTHLY=100

# Plantilla de primer arranque. Hay dos:
#   cloud-init.yaml       droplets de trabajo: Node, Claude Code, gh, Python, uv
#   cloud-init.mini.yaml  maquina de control de 512 MB: solo Node, git y swap
# Se puede elegir por lanzamiento:  launch mini --cloud-init cloud-init.mini.yaml
DO_CLOUD_INIT=cloud-init.yaml

# --- Acceso SSH --------------------------------------------------------------
# Clave privada que usa el comando `ssh` de este script.
# En la otra laptop apunta a la ruta que tenga ahí.
DO_SSH_KEY_FILE=~/.ssh/do_droplet

# Qué claves de la cuenta se embeben en el droplet.
# VACÍO = todas las registradas, que es lo que quieres si entras desde varias
# máquinas. Rellénalo (nombres o fingerprints separados por coma) sólo si
# quieres restringirlo.
DO_SSH_KEYS=

# Con quién entras al hacer `ssh`. 'deploy' es lo cómodo: es el usuario que
# tiene los tokens, la config de git y los repos clonados en ~/src, así que
# aterrizas listo para trabajar. 'root' también funciona, pero desde ahí tendrás
# que hacer `su - deploy` para que Claude Code encuentre sus credenciales.
# El aprovisionamiento entra siempre como root, sea cual sea este valor.
DO_SSH_USER=deploy

# El droplet escucha SSH en el 22 y en el 443. Se prueban en orden y se usa el
# primero que responda: muchas redes corporativas bloquean el 22 saliente.
DO_SSH_PORTS=22,443

# --- Entorno de desarrollo ---------------------------------------------------
# Los tokens de aquí abajo NO viajan en cloud-init: `provision` los empuja por
# SSH cuando el droplet ya arrancó, y quedan en modo 600 del usuario de trabajo.
# El motivo es concreto: el user_data de cloud-init lo sirve la API de metadatos
# del droplet y lo lee cualquier usuario sin privilegios, sin sudo:
#   deploy$ curl http://169.254.169.254/metadata/v1/user-data

# Usuario del droplet que se queda las credenciales y los repos.
DO_DEV_USER=deploy

# Token largo de tu suscripción de Claude. Se genera UNA vez, en tu máquina:
#   claude setup-token
# y se pega aquí. No caduca en cada sesión, así que no hay que repetirlo por
# droplet. Alternativa: ANTHROPIC_API_KEY, pero eso factura aparte por uso.
CLAUDE_CODE_OAUTH_TOKEN=

# Personal Access Token de GitHub, preferiblemente de grano fino:
#   https://github.com/settings/personal-access-tokens
# Permisos mínimos para clonar y hacer push: Contents = Read and write
# sobre los repos que quieras poder tocar desde el droplet.
GITHUB_TOKEN=

# Autoría de los commits que hagas dentro del droplet. Si lo dejas vacío, git
# se quejará la primera vez que commitees allí.
GIT_USER_NAME=
GIT_USER_EMAIL=

# Repos que se clonan solos en ~/src del droplet al lanzarlo. Separados por
# coma. Se puede añadir más en el momento:  launch --repo owner/repo
DO_REPOS=

# --- Servicios ---------------------------------------------------------------
# Procesos que quedan corriendo en el droplet como unidades de systemd (arrancan
# solos, se reinician si mueren). Cada nombre es un descriptor de services/:
# ahí está su repo, cómo se instala y cómo arranca. El repo se clona solo, no
# hace falta repetirlo en DO_REPOS.
#
#   DO_SERVICES=telegram-coordinator
#
# Vacío = ninguno; el droplet queda para trabajo interactivo y nada más.
DO_SERVICES=

# Configuración del servicio telegram-coordinator (bot que te deja hablar con
# Claude Code desde el móvil). Las variables con el prefijo TG_ se copian, sin el
# prefijo, al .env del servicio dentro del droplet, en modo 600. Aquí abajo hay
# secretos: por eso viajan por SSH y no por cloud-init.

# Token del bot, te lo da @BotFather en Telegram con /newbot.
TG_BOT_TOKEN=

# Tu id numérico de Telegram. Es la ÚNICA protección del bot, que por diseño
# ejecuta comandos en el droplet: sin esto no atiende a nadie, y con el id
# equivocado atiende a otro. Si no lo sabes, escríbele /whoami al bot.
TG_ALLOWED_USER_IDS=

# Permisos de Claude Code dentro del bot:
#   bypassPermissions  ejecuta cualquier cosa sin preguntar
#   acceptEdits        edita ficheros sin preguntar, pero no ejecuta shell
#   default            pregunta siempre (desde el movil suele dejarte colgado)
# bypassPermissions es lo util aqui y lo razonable en una maquina efimera y
# aislada, pero asume que quien entre a tu grupo de Telegram tiene shell.
TG_CLAUDE_PERMISSION_MODE=bypassPermissions

# Configuración del servicio telegram-launcher: el MISMO programa, con OTRO bot,
# en la máquina de control. Tiene que ser otro bot y no el mismo: Telegram sólo
# admite un proceso haciendo long polling por token, y el segundo recibe un 409.
# Créalo en @BotFather con /newbot y ponle un nombre que distingas del otro.
#
# Los dos servicios no pueden convivir en un droplet (comparten directorio); van
# en máquinas distintas, que es justo lo que se quiere:
#   al Lanzador le pides máquinas, al Coordinador le pides trabajo.
TGL_BOT_TOKEN=
TGL_ALLOWED_USER_IDS=

# El token de DigitalOcean, que es lo que convierte al mini en lanzador. Llega
# al .env del bot y de ahí al entorno de los comandos que ejecuta, así que
# do_droplet.py lo encuentra solo. Ojo con lo que implica: quien consiga hablar
# con este bot puede crear y destruir máquinas en tu cuenta, o sea gastar
# dinero. La allowlist de arriba es la única barrera.
TGL_DO_TOKEN=

# En el mini no hay Claude Code (no cabe en 512 MB), así que este modo sólo
# afecta si algún día le pones un ejecutor que llame a claude por SSH.
TGL_CLAUDE_PERMISSION_MODE=bypassPermissions
